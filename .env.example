# === Common variables (required for both local and Scaleway) ===
PORT=8080
BACKEND_STORE_URI=postgresql://user:password@mlflow-db-postgresql:5432/dbname
ARTIFACT_ROOT=s3://your-bucket/mlflow-artifacts/
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=your_password
POSTGRES_DB=mlflow_db
POSTGRES_ADMIN_PASSWORD=your_admin_password
MLFLOW_TRACKING_URI=http://localhost:5000

# === Scaleway only (not needed for local deployment) ===
MLFLOW_AUTH_USER=your-email@example.com
MLFLOW_AUTH_PASSWORD=your-secure-password
