# Copy this file to .env and fill in the values. Never commit .env.

# Tracking URI for train.py (it reads this file).
# Local: http://localhost:5000 (port-forward). Scaleway: http://<EXTERNAL_IP> of the Ingress.
MLFLOW_TRACKING_URI=http://localhost:5000

# PostgreSQL password, stored in the Secret mlflow-credentials.
# Letters and digits only (it goes into a connection URI), for example: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# S3 keys of the MLflow server, stored in the Secret mlflow-credentials.
# Local mode (moto): any value works. Scaleway mode: the keys of your real S3 bucket.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# === Scaleway only (not needed for local deployment) ===
# Login of the Ingress basic auth.
MLFLOW_AUTH_USER=user@example.com
MLFLOW_AUTH_PASSWORD=change-me
